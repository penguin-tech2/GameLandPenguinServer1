# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: The backend API & Socket server URL (e.g. your Google Cloud Run instance).
# Leave empty when frontend & backend run together, or set to your Cloud Run URL when hosting static frontend on GitHub Pages.
VITE_API_URL=""

# ADMIN_PASSWORD: Required administrator password for server-side admin authentication.
# Set this in your server environment or AI Studio Secrets before deploying publicly.
# When unset on first run, use the inline First-Run Admin Setup form on the login screen to claim an admin password.
ADMIN_PASSWORD=""

# ALLOWED_ORIGINS: Comma-separated list of trusted frontend origins allowed by CORS (e.g. https://ishaany83-arch.github.io).
# Leave empty to automatically allow same-origin requests and APP_URL.
ALLOWED_ORIGINS=""

